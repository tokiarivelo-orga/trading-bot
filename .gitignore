# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# Env & secrets — NEVER commit credentials
.env
*.key
*.pem
*.enc

# Databases
*.db
*.sqlite3
data/

# Logs
/logs/
*.log

# Per-account gateway PID files (make dev-gateway ACCOUNT=<id>)
gateway/run/

# Backtest outputs — only the generated report JSON files, never source
# code placed in this directory (see backend/src/backtest/reports/writer.py,
# which this exact pattern previously swallowed after `git rm --cached`
# would never apply here, since it was never committed in the first place).
backend/src/backtest/reports/*.json

# Generated demo/marketing videos — large binaries, host externally instead
# of committing (see videos/README.md); keep the folder for local generation.
videos/demo_tour/*.mp4
videos/demo_tour/*.webm

# OS / editors
.DS_Store
.idea/
.vscode/
python-3.12.8-amd64.exe
python-3.12.8-embed-amd64.zip
*.whl
