# Generated by installer/services_linux.py -- do not edit by hand.
# This is a systemd *template* unit (the "@" in the filename): each MT5
# account gets its own instance, enabled as
# `trading-bot-terminal@<account-id>.service`. `%i` below is systemd's own
# specifier for "the instance name" (the part after "@" in whatever unit
# name this file was loaded as) -- it is left as literal `%i` here on
# purpose, NOT substituted by our Python renderer, so systemd resolves it
# natively at load time regardless of which account's file this is.
#
# Mirrors what `make dev-gateway` does before starting a gateway: launch
# that account's terminal64.exe under Wine first, in the same Wine prefix
# the gateway will use.
[Unit]
Description=AI Trading Bot -- MT5 terminal (Wine) for account "%i"
PartOf=trading-bot.target

[Service]
Type=simple
WorkingDirectory=${WINE_PREFIX}
Environment=WINEPREFIX=${WINE_PREFIX}
Environment=WINEDEBUG=${WINEDEBUG}
# Absolute path to `wine`, resolved at generation time (shutil.which).
ExecStart=${WINE_BIN} "${TERMINAL_PATH}"
Restart=on-failure
RestartSec=5
# MT5 terminals can take several seconds to fully connect under Wine --
# give it room before systemd's stop/kill sequence kicks in.
TimeoutStopSec=30

[Install]
WantedBy=default.target
