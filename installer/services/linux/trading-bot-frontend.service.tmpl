[Unit]
Description=AI Trading Bot -- frontend (Next.js dev server)
After=network-online.target trading-bot-backend.service
Wants=network-online.target
PartOf=trading-bot.target

[Service]
Type=simple
WorkingDirectory=${FRONTEND_DIR}
# Absolute path to `pnpm`, resolved at generation time (shutil.which) --
# same reasoning as the backend unit's ExecStart.
ExecStart=${PNPM_BIN} dev --port ${FRONTEND_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
