# Generated by installer/services_linux.py -- do not edit by hand.
# Re-run installer/services_linux.py's generate()/install() to regenerate
# after changing configs/.env or moving the install directory.
[Unit]
Description=AI Trading Bot -- backend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target
PartOf=trading-bot.target

[Service]
Type=simple
WorkingDirectory=${BACKEND_DIR}
# Absolute path to `uv`, resolved at generation time (shutil.which) rather
# than relying on PATH -- systemd user units get a minimal PATH by default,
# and `uv` living in ~/.local/bin or ~/.cargo/bin wouldn't be on it.
ExecStart=${UV_BIN} run uvicorn src.main:socket_app --port ${BACKEND_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
