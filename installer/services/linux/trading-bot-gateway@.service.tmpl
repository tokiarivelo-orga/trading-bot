# Generated by installer/services_linux.py -- do not edit by hand.
# This is a systemd *template* unit (the "@" in the filename): each MT5
# account gets its own instance, enabled as
# `trading-bot-gateway@<account-id>.service`. `%i` below is systemd's own
# specifier for "the instance name" -- left as literal `%i`, NOT substituted
# by our Python renderer, so systemd resolves it natively at load time. It's
# used here to bind this account's gateway to that *same* account's
# terminal unit (trading-bot-terminal@<same-id>.service) without our
# renderer having to know about that cross-reference at all.
[Unit]
Description=AI Trading Bot -- MT5 gateway for account "%i"
After=trading-bot-terminal@%i.service
Requires=trading-bot-terminal@%i.service
PartOf=trading-bot.target

[Service]
Type=simple
WorkingDirectory=${GATEWAY_DIR}
Environment=WINEPREFIX=${WINE_PREFIX}
Environment=WINEDEBUG=${WINEDEBUG}
Environment=GATEWAY_HOST=${GATEWAY_HOST}
Environment=GATEWAY_PORT=${GATEWAY_PORT}
# Host-absolute path to this account's own terminal64.exe (always this
# unit's terminal instance, never blank) -- mt5_client.py converts it to the
# "C:\..." form MetaTrader5 needs from inside the Wine process. Required so
# this gateway attaches to its own terminal, not whichever one happens to
# already be running -- see mt5_client.py's MT5_TERMINAL_PATH comment.
Environment=MT5_TERMINAL_PATH=${MT5_TERMINAL_PATH}
# Value copied from this account's ${GATEWAY_SECRET_ENV_NAME} in .env at
# generation time -- systemd unit files can't shell out to `grep .env` the
# way `make dev-gateway` does on every invocation, so the resolved value is
# baked in here instead. Re-run installer/services_linux.py's generate()/
# install() after rotating this secret in .env. This unit file is written
# with 0600 permissions (owner read/write only) precisely because of this
# line -- see services_linux.py's generate().
Environment=GATEWAY_SHARED_SECRET=${GATEWAY_SHARED_SECRET}
# Absolute paths to `wine` and the Wine-prefix's Windows Python, resolved at
# generation time -- mirrors the Makefile's WINE_PYTHON default and
# `dev-gateway`'s `wine $$(WINE_PYTHON) run_gateway.py` invocation exactly.
# run_gateway.py itself adds gateway/src to sys.path (Wine doesn't forward
# PYTHONPATH to the Windows process) -- see gateway/README.md.
ExecStart=${WINE_BIN} "${WINE_PYTHON}" run_gateway.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
